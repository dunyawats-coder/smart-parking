# ความลับ / ค่าเฉพาะเครื่อง
web/config.php
.env
firmware/**/secrets.h
# ข้อมูลที่ผู้ใช้อัปโหลด (สลิป, ภาพกล้อง) - ห้ามขึ้น GitHub
